# Copy to env.config (or set these as real environment variables) and fill in values.
# env.config is git-ignored - never commit real secrets.

DB_DIALECT=mysql
DB_HOST=localhost
DB_NAME=
DB_USER=
DB_PASSWORD=

# Long random string, e.g. `openssl rand -hex 48`
JWT_SECRET=

PORT=5001
NODE_ENV=production

# Comma-separated list of allowed browser origins (leave empty to allow all)
CORS_ORIGINS=https://viveralighting.com,https://www.viveralighting.com

# Used in password-reset emails
FRONTEND_URL=https://viveralighting.com
EMAIL_USER=
EMAIL_PASSWORD=
GOOGLE_CLIENT_ID=

# Initial admin account (created only if it does not exist yet).
# If ADMIN_PASSWORD is unset a random one is generated and printed once.
ADMIN_EMAIL=admin@citylights.com
ADMIN_PASSWORD=
# Set to true (with ADMIN_PASSWORD) to force-reset the existing admin password once
ADMIN_RESET_PASSWORD=false
